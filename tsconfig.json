{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "ignoreDeprecations": "6.0",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@metis/shared": [
        "./packages/shared/src/index.ts"
      ],
      "@metis/shared/*": [
        "./packages/shared/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "middleware.ts",
    "tailwind.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "db/**/*.ts",
    "scripts/**/*.ts",
    "packages/shared/**/*.ts",
    "packages/shared/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "design/**",
    "northbank-timeline-asset/**",
    "station-timeline-asset/**",
    "**/*-timeline-asset/**",
    "video/walkthrough/**"
  ]
}
