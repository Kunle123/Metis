DATABASE_URL=

# JWT cookie mint/verification for legacy email+password (`/api/auth/login`).
METIS_SESSION_SECRET=

# ------- Optional Clerk SSO (transitional alongside legacy auth) --------
# Omit both keys locally to stay bcrypt + JWT only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhooks deferred: syncing Clerk invitations / organisations into Metis memberships is not implemented yet.

CLERK_WEBHOOK_SECRET=
# Hosted sign-in/up URL overrides only if you use Clerk-hosted pages directly (embedded flow on `/login` does not require these).

NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=

# Optional: required for "Structure with AI" on New issue. If unset, the API returns 503.
# OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=
MESSAGES_AI_CLEANUP_ENABLED=false  # Optional; off by default — set true (with OPENAI_API_KEY) to enable Messages wording polish only.
BRIEF_AI_SYNTHESIS_ENABLED=false  # Optional; off by default — set true (with OPENAI_API_KEY) for AI-assisted executive-summary text on full-issue brief regeneration (deterministic artifact is always generated).

# Issue workspace capture-notes AI extraction suggestions (endpoint only — no writes). Default off.
NOTES_CAPTURE_AI_ENABLED=false
